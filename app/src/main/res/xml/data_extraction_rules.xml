<?xml version="1.0" encoding="utf-8"?>
<!--
  Strict file-level allowlist for Android 12+ backup and device transfer.
  Includes only user configuration. Deliberately NOT backed up:
  - usage_statistics.xml (local usage history),
  - sorting_settings.xml (contains usage-derived automatic snapshots),
  - backup_runtime.xml (UI results/ephemeral backup state),
  - WebView data, cookies, databases, files, journal and cache.
  sorting configuration is safely mirrored into system_backup_sorting.xml.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="sharedpref" path="categories.xml" />
        <include domain="sharedpref" path="favorites.xml" />
        <include domain="sharedpref" path="shortcuts.xml" />
        <include domain="sharedpref" path="overview_order.xml" />
        <include domain="sharedpref" path="section_item_order.xml" />
        <include domain="sharedpref" path="overview_display.xml" />
        <include domain="sharedpref" path="ui_settings.xml" />
        <include domain="sharedpref" path="statistics_display.xml" />
        <include domain="sharedpref" path="system_backup_sorting.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="categories.xml" />
        <include domain="sharedpref" path="favorites.xml" />
        <include domain="sharedpref" path="shortcuts.xml" />
        <include domain="sharedpref" path="overview_order.xml" />
        <include domain="sharedpref" path="section_item_order.xml" />
        <include domain="sharedpref" path="overview_display.xml" />
        <include domain="sharedpref" path="ui_settings.xml" />
        <include domain="sharedpref" path="statistics_display.xml" />
        <include domain="sharedpref" path="system_backup_sorting.xml" />
    </device-transfer>
</data-extraction-rules>
