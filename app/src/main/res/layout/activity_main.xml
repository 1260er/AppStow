<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/ui_background"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingVertical="@dimen/screen_padding_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/pageTitle"
                style="@style/UiScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_title"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/buttonOpenMenu"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_open_menu"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_menu" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/appSearchContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:visibility="gone">

            <EditText
                android:id="@+id/appSearch"
                style="@style/UiSearchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/search_apps_hint"
                android:inputType="text"
                android:paddingEnd="56dp" />

            <ImageButton
                android:id="@+id/appSearchClear"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:layout_gravity="end|center_vertical"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_clear_search"
                android:focusable="false"
                android:padding="12dp"
                android:src="@drawable/ic_clear"
                android:visibility="gone" />

        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/spacing_lg"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/pageContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <include layout="@layout/view_navigation_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
