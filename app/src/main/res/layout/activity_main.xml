<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/ui_background"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingVertical="@dimen/screen_padding_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/pageTitle"
                style="@style/UiScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_title"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/buttonSortOverview"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_sort_overview"
                android:padding="10dp"
                android:src="@drawable/ic_sort_overview"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/buttonOpenMenu"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_open_menu"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_menu" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/appSearchContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:visibility="gone">

            <EditText
                android:id="@+id/appSearch"
                style="@style/UiSearchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/search_apps_hint"
                android:inputType="text"
                android:paddingEnd="56dp" />

            <ImageButton
                android:id="@+id/appSearchClear"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:layout_gravity="end|center_vertical"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_clear_search"
                android:focusable="false"
                android:padding="12dp"
                android:src="@drawable/ic_clear"
                android:visibility="gone" />

        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/spacing_lg">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/overviewList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/categoryManagement"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/categoryAddButton"
                    style="@style/UiBodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/overview_section_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:text="@string/action_add_category"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/categoryEmptyMessage"
                    style="@style/UiBodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/category_empty"
                    android:textColor="@color/ui_text_secondary"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/categoryList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:clipToPadding="false" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/shortcutManagement"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/shortcutAddButton"
                    style="@style/UiBodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/overview_section_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:text="@string/action_add_shortcut"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/shortcutEmptyMessage"
                    style="@style/UiBodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/shortcut_empty"
                    android:textColor="@color/ui_text_secondary"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/shortcutList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:clipToPadding="false" />

            </LinearLayout>

            <TextView
                android:id="@+id/pageMessage"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:visibility="gone" />

        </FrameLayout>
    </LinearLayout>

    <include layout="@layout/view_navigation_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
