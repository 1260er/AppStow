<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/shortcutEditName"
            style="@style/UiSearchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/shortcut_name_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:singleLine="true" />

        <Spinner
            android:id="@+id/shortcutEditType"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/spacing_md" />

        <TextView
            android:id="@+id/shortcutNetworkWarning"
            style="@style/UiBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:text="@string/webapp_network_missing"
            android:textColor="@color/ui_danger"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/shortcutNetworkHelp"
            style="@style/UiBodyText"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:text="@string/webapp_network_check"
            android:textColor="@color/ui_accent"
            android:visibility="gone" />

        <EditText
            android:id="@+id/shortcutEditTarget"
            style="@style/UiSearchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/shortcut_target_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:singleLine="true" />

        <TextView
            android:id="@+id/shortcutPickCategories"
            style="@style/UiBodyText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/overview_section_background"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/spacing_md"
            android:text="@string/shortcut_categories" />

        <CheckBox
            android:id="@+id/shortcutEditFavorite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/shortcut_favorite"
            android:textColor="@color/ui_text_primary" />

    </LinearLayout>

</ScrollView>
