<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sortingManagement"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/UiBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sorting_description"
            android:textColor="@color/ui_text_secondary" />

        <RadioGroup
            android:id="@+id/sortingModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg">

            <RadioButton
                android:id="@+id/sortingModeManual"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/sorting_mode_manual" />

            <RadioButton
                android:id="@+id/sortingModeSemi"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/sorting_mode_semi" />

            <RadioButton
                android:id="@+id/sortingModeAutomatic"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/sorting_mode_automatic" />

        </RadioGroup>

        <LinearLayout
            android:id="@+id/sortingManualSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical">

            <TextView
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sorting_manual_description"
                android:textColor="@color/ui_text_secondary" />

            <CheckBox
                android:id="@+id/sortingSuggestionsEnabled"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:minHeight="48dp"
                android:text="@string/sorting_suggestions_enabled" />

            <TextView
                android:id="@+id/sortingSuggestionFavoriteCount"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/overview_section_background"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:paddingHorizontal="@dimen/spacing_md"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sortingSuggestionInterval"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/overview_section_background"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:paddingHorizontal="@dimen/spacing_md"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sortingSuggestionCheckNow"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/overview_section_background"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:paddingHorizontal="@dimen/spacing_md"
                android:text="@string/sorting_suggestion_check_now"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/sortingSemiSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sorting_semi_description"
                android:textColor="@color/ui_text_secondary" />

            <CheckBox
                android:id="@+id/sortingSemiFavorites"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:minHeight="48dp"
                android:text="@string/sorting_area_favorites" />

            <CheckBox
                android:id="@+id/sortingSemiCategories"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/sorting_area_categories" />

            <CheckBox
                android:id="@+id/sortingSemiApps"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/sorting_area_apps" />

            <CheckBox
                android:id="@+id/sortingSemiShortcuts"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/sorting_area_shortcuts" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/sortingAutomaticSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sorting_automatic_description"
                android:textColor="@color/ui_text_secondary" />

        </LinearLayout>
        <LinearLayout
            android:id="@+id/sortingTimeSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/sortingTimeProfileBrief"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sorting_time_profile_brief"
                android:textColor="@color/ui_text_secondary" />

            <LinearLayout
                android:id="@+id/sortingTimeProfileRow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/icon_button_size"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/sortingTimeProfileEnabled"
                    style="@style/UiBodyText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/sorting_time_profile" />

                <ImageButton
                    android:id="@+id/sortingTimeProfileHelp"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/sorting_time_profile_help_action"
                    android:padding="12dp"
                    android:src="@drawable/ic_help_circle"
                    android:tooltipText="@string/sorting_time_profile_help_action" />

            </LinearLayout>

            <TextView
                android:id="@+id/sortingFavoriteCount"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/overview_section_background"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:paddingHorizontal="@dimen/spacing_md"
                android:textStyle="bold" />


            <LinearLayout
                android:id="@+id/sortingTimeDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/sortingDayStart"
                    style="@style/UiBodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@drawable/overview_section_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sortingEveningStart"
                    style="@style/UiBodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@drawable/overview_section_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>

</ScrollView>
