<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:background="@drawable/overview_section_background"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/categoryName"
        style="@style/UiBodyText"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="@dimen/spacing_md" />

    <ImageButton
        android:id="@+id/categoryDelete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_delete_category"
        android:padding="12dp"
        android:src="@drawable/ic_delete" />

</LinearLayout>
