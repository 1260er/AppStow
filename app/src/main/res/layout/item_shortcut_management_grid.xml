<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="128dp"
    android:layout_marginHorizontal="2dp"
    android:layout_marginBottom="6dp"
    android:background="?android:attr/selectableItemBackground"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/shortcutContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/shortcutIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:padding="8dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/shortcutName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/ui_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shortcutSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/ui_text_secondary"
            android:textSize="10sp" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/shortcutFavorite"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-2dp"
        android:layout_marginEnd="-2dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_add_favorite"
        android:padding="7dp"
        android:src="@drawable/ic_star_outline" />

    <ImageButton
        android:id="@+id/shortcutDelete"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-2dp"
        android:layout_marginBottom="-2dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_delete_shortcut"
        android:padding="7dp"
        android:src="@drawable/ic_delete" />

</FrameLayout>
