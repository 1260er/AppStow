<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navigationDrawer"
    android:layout_width="@dimen/drawer_width"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="@color/ui_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingVertical="@dimen/screen_padding_vertical">

        <TextView
            style="@style/UiScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:text="@string/app_name"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navOverview"
            style="@style/UiDrawerItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_overview" />

        <TextView
            android:id="@+id/navApps"
            style="@style/UiDrawerItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_apps" />

        <TextView
            android:id="@+id/navCategories"
            style="@style/UiDrawerItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_categories" />

        <TextView
            android:id="@+id/navSettings"
            style="@style/UiDrawerItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_settings" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/navHelp"
            style="@style/UiDrawerItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_help" />

        <TextView
            android:id="@+id/navAbout"
            style="@style/UiDrawerItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_about" />

    </LinearLayout>
</ScrollView>
