<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_md"
    android:background="@drawable/overview_section_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_sm"
    android:paddingBottom="@dimen/spacing_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/statisticsCardTitle"
            style="@style/UiBodyText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/statisticsCardDragHandle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/action_drag_statistics_card"
            android:padding="12dp"
            android:src="@drawable/ic_drag_handle"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/statisticsCardProminentContent"
        style="@style/UiScreenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/statisticsCardRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:orientation="vertical" />

</LinearLayout>
