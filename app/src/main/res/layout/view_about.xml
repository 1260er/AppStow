<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aboutManagement"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/overview_section_background"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_app_name"
                android:textStyle="bold" />

            <TextView
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/about_description"
                android:textColor="@color/ui_text_secondary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/overview_section_background"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_details_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/aboutVersion"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:textColor="@color/ui_text_secondary" />

            <TextView
                android:id="@+id/aboutPackage"
                style="@style/UiBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textColor="@color/ui_text_secondary"
                android:textIsSelectable="true" />

        </LinearLayout>

        <TextView
            android:id="@+id/aboutGithubButton"
            style="@style/UiBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/overview_section_background"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:paddingHorizontal="@dimen/spacing_md"
            android:text="@string/about_github"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
