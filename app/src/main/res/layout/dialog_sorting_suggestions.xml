<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <TextView
            style="@style/UiBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sorting_suggestion_preview_intro"
            android:textColor="@color/ui_text_secondary" />

        <CheckBox
            android:id="@+id/suggestionApplyFavoriteOrder"
            style="@style/UiBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:minHeight="48dp"
            android:text="@string/sorting_suggestion_favorites_order" />

        <TextView
            android:id="@+id/suggestionFavoriteOrderPreview"
            style="@style/UiBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_sm"
            android:textColor="@color/ui_text_secondary"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/suggestionApplyFavoriteAssignment"
            style="@style/UiBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="48dp"
            android:text="@string/sorting_suggestion_favorites_assignment" />

        <TextView
            android:id="@+id/suggestionFavoriteAssignmentPreview"
            style="@style/UiBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_sm"
            android:textColor="@color/ui_text_secondary"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/suggestionApplyCategories"
            style="@style/UiBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="48dp"
            android:text="@string/sorting_suggestion_categories_order" />

        <TextView
            android:id="@+id/suggestionCategoriesPreview"
            style="@style/UiBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_sm"
            android:textColor="@color/ui_text_secondary"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/suggestionApplyApps"
            style="@style/UiBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="48dp"
            android:text="@string/sorting_suggestion_apps_order" />

        <TextView
            android:id="@+id/suggestionAppsPreview"
            style="@style/UiBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_sm"
            android:textColor="@color/ui_text_secondary"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/suggestionApplyShortcuts"
            style="@style/UiBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="48dp"
            android:text="@string/sorting_suggestion_shortcuts_order" />

        <TextView
            android:id="@+id/suggestionShortcutsPreview"
            style="@style/UiBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_sm"
            android:textColor="@color/ui_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
