    <string name="help_example_maps_title">Google Maps – Navigation</string>
    <string name="help_example_maps">https://www.google.com/maps/dir/?api=1&amp;destination=Berlin</string>

    <string name="help_example_whatsapp_title">WhatsApp – Nachricht</string>
    <string name="help_example_whatsapp">whatsapp://send?phone=+491701234567&amp;text=Hallo</string>

    <string name="help_example_camera_title">Kamera</string>
    <string name="help_example_camera">intent:#Intent;action=android.media.action.IMAGE_CAPTURE;end</string>

    <string name="help_example_phone_title">Telefon</string>
    <string name="help_example_phone">tel:+491701234567</string>

    <string name="help_shortcut_settings_title">App-Einstellungen</string>
    <string name="help_shortcut_settings_text">Öffnet direkt die Android-App-Informationen der angegebenen App.</string>
    <string name="help_example_settings">package:com.example.app</string>

    <string name="help_sort_title">Sortieren</string>

    <string name="help_sort_sections_title">Bereiche verschieben</string>
    <string name="help_sort_sections_text">Tippe in der Übersicht auf das Sortiersymbol, um die Reihenfolge der Bereiche zu ändern.</string>
    <string name="help_sort_items_title">Apps und Shortcuts sortieren</string>
    <string name="help_sort_items_text">Tippe auf das Sortiersymbol innerhalb eines Bereichs. Ziehe die Einträge an ihren Anfassern an die gewünschte Position. In der Kachelansicht kannst du die Kacheln über die Anfasser rechts oben in alle vier Richtungen verschieben.</string>
    <string name="help_sort_finish_title">Reihenfolge speichern</string>
    <string name="help_sort_finish_text">Tippe auf das Häkchen, um die Sortierung zu beenden. Die neue Reihenfolge wird gespeichert.</string>
    <string name="help_backup_title">Backup &amp; Wiederherstellen</string>

    <string name="help_backup_create_title">Backup erstellen</string>
    <string name="help_backup_create_text">Unter Backup &amp; Wiederherstellen sicherst du deine Konfiguration als JSON-Datei. Sie enthält Kategorien, Zuweisungen, Favoriten, Shortcuts, Sortierreihenfolgen und Anzeigeeinstellungen einschließlich der globalen und individuellen Spaltenzahlen.</string>
    <string name="help_backup_restore_title">Backup wiederherstellen</string>
    <string name="help_backup_restore_text">Beim Wiederherstellen wird die vorhandene Konfiguration ersetzt. Ältere Backups ohne Anzeigeeinstellungen verwenden die Standardansicht.</string>
    <string name="help_backup_excluded_title">Nicht enthalten</string>
    <string name="help_backup_excluded_text">Web-App-Anmeldungen, Cookies und Android-Berechtigungen werden nicht gesichert.</string>
    <string name="about_app_name">AppStow</string>
    <string name="about_description">Ein kompakter App-Launcher für Favoriten, Kategorien, eigene Shortcuts und Web-Apps. Deine Anwendungen bleiben übersichtlich verstaut und schnell erreichbar.</string>
    <string name="about_name_origin_title">Wie der Name entstanden ist</string>
    <string name="about_name_origin_text">Der Name AppStow setzt sich aus App, der Kurzform für Anwendung, und dem englischen Wort stow zusammen. Stow bedeutet, etwas ordentlich zu verstauen. Genau das ist die Idee hinter AppStow: Anwendungen übersichtlich verstauen und bei Bedarf schnell wiederfinden.</string>
