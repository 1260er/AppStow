<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/ui_background</item>
        <item name="android:colorAccent">@color/ui_accent</item>
        <item name="android:statusBarColor">@color/ui_background</item>
        <item name="android:navigationBarColor">@color/ui_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="UiScreenTitle">
        <item name="android:textColor">@color/ui_text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="UiBodyText">
        <item name="android:textColor">@color/ui_text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>
    <style name="UiSearchInput">
        <item name="android:background">@drawable/ui_input_background</item>
        <item name="android:textColor">@color/ui_text_primary</item>
        <item name="android:textColorHint">@color/ui_text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:paddingStart">@dimen/spacing_md</item>
        <item name="android:paddingEnd">@dimen/spacing_md</item>
        <item name="android:singleLine">true</item>
    </style>

</resources>
