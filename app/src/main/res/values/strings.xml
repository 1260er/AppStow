    <string name="help_sort_title">Sorting</string>

    <string name="help_sort_sections_title">Rearrange sections</string>
    <string name="help_sort_sections_text">Tap the sort icon in the overview to change the order of the sections.</string>
    <string name="help_sort_items_title">Rearrange apps and shortcuts</string>
    <string name="help_sort_items_text">Tap the sort icon inside a section. Drag entries using their handles. In grid view, tiles can be moved in all four directions using the handles at the upper right.</string>
    <string name="help_sort_finish_title">Save the order</string>
    <string name="help_sort_finish_text">Tap the check mark to finish sorting. The new order is saved.</string>
    <string name="help_backup_title">Backup &amp; Restore</string>

    <string name="help_backup_create_title">Create a backup</string>
    <string name="help_backup_create_text">Under Backup &amp; Restore, create an encrypted backup of your AppStow configuration. It includes categories, assignments, favorites, custom shortcuts, manual orders, sorting, display and control settings, including language and statistics display settings.</string>
    <string name="help_backup_restore_title">Restore a backup</string>
    <string name="help_backup_restore_text">Restoring replaces the current configuration. Usage statistics are reset. Apps that are no longer installed are removed from favorites, category assignments and app orders. Categories and custom shortcuts remain.</string>
    <string name="help_backup_excluded_title">Not included</string>
    <string name="help_backup_excluded_text">Usage statistics, web app sessions and cookies are not backed up.</string>
    <string name="about_app_name">AppStow</string>
    <string name="about_description">A compact app launcher for favorites, categories, custom shortcuts and web apps. Keep your applications organized and ready to launch.</string>
    <string name="about_name_origin_title">Where the name comes from</string>
    <string name="about_name_origin_text">AppStow combines App, short for application, with the English word stow, meaning to put something away neatly. The idea behind the name is simple: a place to stow your applications and find them again whenever you need them.</string>
