    <string name="help_overview_title">Launch apps</string>
    <string name="help_overview_text">Here you can find favorites, your categories, and custom shortcuts. Tap a heading to expand or collapse the section. Tap apps and shortcuts to launch them.</string>

    <string name="help_categories_title">Favorites &amp; Categories</string>
    <string name="help_categories_text">Favorites appear in the “Favorites” section. You can create, rename, or delete categories under “Manage categories”.</string>

    <string name="help_apps_title">Assign apps</string>
    <string name="help_apps_text">Press and hold an app to assign it to one or more categories. Use the filter icon to show only apps that have not yet been assigned to a category.</string>

    <string name="help_shortcuts_title">Custom shortcuts</string>

    <string name="help_shortcut_website_title">Website</string>
    <string name="help_shortcut_website_text">Opens a normal http or https address with the appropriate app or the default browser.</string>

    <string name="help_shortcut_webapp_title">Web app</string>
    <string name="help_shortcut_webapp_text">Opens an HTTPS website directly inside AppStow in full screen. Logins and cookies are stored in the app data independently of the normal browser. A network connection is required.</string>

    <string name="help_shortcut_deeplink_title">Deep link (advanced)</string>
    <string name="help_shortcut_deeplink_text">Opens a specific function of an app. Which links work depends on the app. Android intent URIs can also be used.</string>

    <string name="help_example_maps_title">Google Maps – Navigation</string>
    <string name="help_example_maps">https://www.google.com/maps/dir/?api=1&amp;destination=Berlin</string>

    <string name="help_example_whatsapp_title">WhatsApp – Message</string>
    <string name="help_example_whatsapp">whatsapp://send?phone=+491701234567&amp;text=Hello</string>

    <string name="help_example_camera_title">Camera</string>
    <string name="help_example_camera">intent:#Intent;action=android.media.action.IMAGE_CAPTURE;end</string>

    <string name="help_example_phone_title">Phone</string>
    <string name="help_example_phone">tel:+491701234567</string>

    <string name="help_shortcut_settings_title">App settings</string>
    <string name="help_shortcut_settings_text">Opens the Android app information for the specified app directly.</string>
    <string name="help_example_settings">package:com.example.app</string>

    <string name="help_sort_title">Sorting</string>
    <string name="help_sort_text">Use the sort icon at the top to move sections. The sort icon inside a section sorts its apps and shortcuts. Drag the displayed handles to the desired position.</string>

    <string name="help_backup_title">Backup &amp; Restore</string>
    <string name="help_backup_text">A backup contains categories, assignments, favorites, custom shortcuts, and all sorting orders. Web app logins, cookies, and Android permissions are not backed up.</string>

