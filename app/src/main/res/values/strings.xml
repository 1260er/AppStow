    <string name="help_overview_title">Launch apps</string>
    <string name="help_overview_text">Favorites, categories and custom shortcuts are grouped into sections. Tap an app or shortcut to launch it.</string>

    <string name="help_overview_search_text">Use the search field to find apps and shortcuts across all sections.</string>
    <string name="help_grid_title">List and grid view</string>
    <string name="help_grid_switch_title">Switch views</string>
    <string name="help_grid_switch_text">Tap the view icon in the overview to switch between list and grid view.</string>
    <string name="help_grid_global_title">Set the global column count</string>
    <string name="help_grid_global_text">Touch and hold the view icon to choose 3, 4 or 5 columns for the grid overview.</string>
    <string name="help_grid_open_title">Open a section</string>
    <string name="help_grid_open_text">Tap a category tile to open its contents. Favorites and Custom shortcuts work the same way. Use the section heading or Back to return to the overview.</string>
    <string name="help_grid_individual_title">Global or individual columns</string>
    <string name="help_grid_individual_text">Use the view icon inside an open section to choose Global, 3, 4 or 5 columns. Global follows the overview column count, including later changes. A fixed number stays independent.</string>
    <string name="help_categories_title">Favorites &amp; Categories</string>
    <string name="help_categories_text">Under Manage categories, you can create, rename and delete categories. Every category has an emoji that is always shown in the overview. Apps and custom shortcuts can belong to multiple categories.</string>

    <string name="help_categories_favorites_text">Use the star to add or remove favorites. Favorites and Custom shortcuts also have their own sections.</string>
    <string name="help_apps_title">Assign apps</string>
    <string name="help_apps_text">Tap an app under Assign apps to open its category assignment directly. Apps and shortcuts can belong to several categories. Tap the star separately to add or remove a favorite.</string>

    <string name="help_apps_filter_text">Use the filter icon to show only apps that have not yet been assigned. The search field helps you find installed apps.</string>
    <string name="help_apps_view_title">List or grid view</string>
    <string name="help_apps_view_text">Assign apps automatically uses the global list or grid view and the global column count. Change these settings using the view icon on the Launch apps page. Apps are launched only from Launch apps.</string>
    <string name="help_shortcuts_title">Custom shortcuts</string>

    <string name="help_shortcut_website_title">Website</string>
    <string name="help_shortcut_website_text">Opens a normal http or https address with the appropriate app or the default browser.</string>

    <string name="help_shortcut_webapp_title">Web app</string>
    <string name="help_shortcut_webapp_text">Opens only an HTTPS website directly inside AppStow. Logins and cookies are stored in the app data independently of the normal browser. A network connection is required. Full-screen content such as video is supported.</string>
    <string name="help_shortcut_webapp_permissions_title">Permissions, files and downloads</string>
    <string name="help_shortcut_webapp_permissions_text">Websites can request file selection, camera, microphone or location access. Required Android permissions are requested when needed. Downloads from HTTPS addresses can be saved through AppStow. Grant permissions only to websites you trust.</string>
    <string name="help_shortcut_webapp_navigation_title">Navigation and errors</string>
    <string name="help_shortcut_webapp_navigation_text">Back first navigates through the web app history. If there is no previous entry, the web app is closed. Loading, HTTP, SSL and WebView process errors are handled and displayed by AppStow.</string>

    <string name="help_shortcut_deeplink_title">Deep link (advanced)</string>
    <string name="help_shortcut_deeplink_text">Opens a specific function of an app. Which links work depends on the app. Android intent URIs can also be used.</string>

